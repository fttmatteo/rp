# Copia este archivo como produccion.env y llena los valores. No lo subas al repositorio.
# Clave de la base de datos (larga y aleatoria).
POSTGRES_PASSWORD=
# Clave inicial del usuario "admin" (mínimo 8 caracteres). Cámbiala en Usuarios al primer ingreso.
SEED_ADMIN_PASSWORD=
# Nombre de la empresa que usa el software (obligatorio): sale en el encabezado de la app, el inicio de sesión,
# los recibos y los reportes. RP Software solo firma al pie de los documentos.
EMPRESA_NOMBRE=
# Token del túnel: Cloudflare Zero Trust > Networks > Tunnels > Create tunnel > Docker.
TUNNEL_TOKEN=
# Cuántos días se guardan las copias diarias de la base de datos.
DIAS_RESPALDO=30
# Versión de las imágenes de GitHub Container Registry que se usa al actualizar con "docker compose pull":
# "latest" (lo último de main), "sha-abc1234" (un commit) o "1.2.0" (una etiqueta v1.2.0). Ver el README.
RP_VERSION=latest
