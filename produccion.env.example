# Copia este archivo como produccion.env y llena los valores. No lo subas al repositorio.
# Clave de la base de datos (larga y aleatoria).
POSTGRES_PASSWORD=
# Clave inicial del usuario "admin" (mínimo 8 caracteres). Cámbiala en Usuarios al primer ingreso.
SEED_ADMIN_PASSWORD=
# Token del túnel: Cloudflare Zero Trust > Networks > Tunnels > Create tunnel > Docker.
TUNNEL_TOKEN=
# Cuántos días se guardan las copias diarias de la base de datos.
DIAS_RESPALDO=30
