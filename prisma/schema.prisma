// Modelo de datos de RP Software.
// Reglas: el dinero se guarda en pesos enteros; inventario, cartera y pagos
// se calculan a partir de registros que no se borran (se anulan).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------- Usuarios y accesos ----------

enum Acceso {
  ADMIN
  VENTAS
  REPARTIDOR
}

model Usuario {
  id               Int       @id @default(autoincrement())
  nombre           String
  usuario          String    @unique
  claveHash        String
  accesos          Acceso[]
  activo           Boolean   @default(true)
  creadoEn         DateTime  @default(now())
  // Freno contra adivinar claves: tras varios intentos fallidos se bloquea un rato.
  intentosFallidos Int       @default(0)
  bloqueadoHasta   DateTime?

  sesiones        Sesion[]
  movimientosCaja MovimientoCaja[]
  cierres         Caja[]
  auditoria       Auditoria[]
  movimientos     MovimientoInventario[]
  clasificaciones RegistroClasificacion[]
  compras         Compra[]
  pagosProveedor  PagoProveedor[]
  novedades       NovedadAves[]
  pedidos         Pedido[]
  ventas          Venta[]
  pagos           Pago[]
  rutas           Ruta[]                  @relation("RepartidorRuta")
  rutasLiquidadas Ruta[]                  @relation("LiquidadorRuta")
}

model Sesion {
  // SHA-256 del token que va en la cookie
  id        String   @id
  usuarioId Int
  operacion Acceso?
  expira    DateTime
  creadaEn  DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
}

model Auditoria {
  id        Int      @id @default(autoincrement())
  fecha     DateTime @default(now())
  usuarioId Int?
  entidad   String
  entidadId String?
  accion    String
  detalle   Json?

  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([entidad, entidadId])
}

// ---------- Productos y precios ----------

enum TipoProducto {
  CUBETA // cubeta de 30 huevos; el inventario se lleva en huevos
  GALLINA // se vende por unidad
  GALLINAZA // abono; se vende por la unidad que elija el administrador (bulto, kilo o viaje)
}

model Producto {
  id                    Int          @id @default(autoincrement())
  codigo                String       @unique
  nombre                String
  tipo                  TipoProducto
  orden                 Int          @default(0)
  precioGeneral         Int
  // Precio especial sugerido al configurar un cliente especial
  precioClienteSugerido Int?
  // Solo gallinaza: "bulto", "kilo" o "viaje". El precio y el inventario van en esa unidad.
  unidad                String?
  // Alerta de existencias bajas: cubetas, gallinas o unidades de gallinaza. Null = sin alerta.
  minimo                Int?
  activo                Boolean      @default(true)
  // Suma de sus movimientos de inventario, actualizada en la misma transacción
  // que cada movimiento para no tener que sumar todo el historial.
  existencias           Int          @default(0)

  preciosCliente   PrecioCliente[]
  historialPrecios HistorialPrecio[]
  movimientos      MovimientoInventario[]
  detallesClasif   DetalleClasificacion[]
  detallesPedido   DetallePedido[]
  detallesCompra   DetalleCompra[]
}

model PrecioCliente {
  clienteId  Int
  productoId Int
  precio     Int

  cliente  Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoId], references: [id])

  @@id([clienteId, productoId])
}

model HistorialPrecio {
  id             Int      @id @default(autoincrement())
  fecha          DateTime @default(now())
  productoId     Int
  clienteId      Int? // null = precio general
  precioAnterior Int?
  precioNuevo    Int? // null = se quitó el precio especial
  usuarioId      Int?

  producto Producto @relation(fields: [productoId], references: [id])
  cliente  Cliente? @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([fecha])
}

// ---------- Clientes ----------

model Cliente {
  id              Int      @id @default(autoincrement())
  nombre          String
  telefono        String?
  direccion       String?
  zona            String?
  // Ubicación GPS opcional para abrir la parada en Google Maps.
  latitud         Float?
  longitud        Float?
  notas           String?
  cupoCredito     Int? // null = sin límite
  diasCredito     Int      @default(15)
  activo          Boolean  @default(true)
  // Cliente genérico de la venta en el punto para quien compra una vez y no está registrado. Hay uno solo.
  consumidorFinal Boolean  @default(false)
  creadoEn        DateTime @default(now())

  precios   PrecioCliente[]
  historial HistorialPrecio[]
  pedidos   Pedido[]
  ventas    Venta[]
  pagos     Pago[]

  @@index([activo, nombre])
}

// ---------- Inventario ----------

enum TipoMovimiento {
  PRODUCCION
  VENTA
  AJUSTE
  ROTURA
  ANULACION
  COMPRA // huevo comprado a terceros (al recibirlo clasificado o al clasificarlo después)
}

model MovimientoInventario {
  id              Int            @id @default(autoincrement())
  fecha           DateTime       @default(now())
  productoId      Int
  // Huevos para productos CUBETA, unidades para GALLINA. Negativo = salida.
  cantidad        Int
  tipo            TipoMovimiento
  nota            String?
  usuarioId       Int?
  ventaId         Int?
  clasificacionId Int?
  compraId        Int?
  novedadId       Int? // gallinas que pasan de un galpón a la venta

  producto      Producto               @relation(fields: [productoId], references: [id])
  compra        Compra?                @relation(fields: [compraId], references: [id])
  novedad       NovedadAves?           @relation(fields: [novedadId], references: [id])
  usuario       Usuario?               @relation(fields: [usuarioId], references: [id])
  venta         Venta?                 @relation(fields: [ventaId], references: [id])
  clasificacion RegistroClasificacion? @relation(fields: [clasificacionId], references: [id])

  @@index([productoId])
}

model RegistroClasificacion {
  id        Int      @id @default(autoincrement())
  fecha     DateTime @db.Date
  creadoEn  DateTime @default(now())
  usuarioId Int
  rotos     Int      @default(0)
  nota      String?
  // Si viene de una compra sin clasificar; null = producción propia.
  compraId  Int?
  // Grupo de aves (galpón) que puso esos huevos (producción propia), para el % de postura.
  grupoId   Int?

  usuario     Usuario                @relation(fields: [usuarioId], references: [id])
  compra      Compra?                @relation(fields: [compraId], references: [id])
  grupo       GrupoAves?             @relation(fields: [grupoId], references: [id])
  detalles    DetalleClasificacion[]
  movimientos MovimientoInventario[]
}

model DetalleClasificacion {
  registroId Int
  productoId Int
  cantidad   Int // huevos, o gallinas pasadas a venta

  registro RegistroClasificacion @relation(fields: [registroId], references: [id], onDelete: Cascade)
  producto Producto              @relation(fields: [productoId], references: [id])

  @@id([registroId, productoId])
}

// ---------- Pedidos, ventas y cartera ----------

enum EstadoPedido {
  PENDIENTE
  ENTREGADO
  NO_ENTREGADO // el repartidor no lo pudo entregar; se puede reprogramar como pedido nuevo
  CANCELADO
}

model Pedido {
  id              Int          @id @default(autoincrement())
  clienteId       Int
  fechaEntrega    DateTime     @db.Date
  estado          EstadoPedido @default(PENDIENTE)
  nota            String?
  creadoEn        DateTime     @default(now())
  creadoPorId     Int
  rutaId          Int?
  ordenEnRuta     Int?
  motivoNoEntrega String?

  cliente   Cliente         @relation(fields: [clienteId], references: [id])
  creadoPor Usuario         @relation(fields: [creadoPorId], references: [id])
  ruta      Ruta?           @relation(fields: [rutaId], references: [id])
  detalles  DetallePedido[]
  venta     Venta?

  @@index([estado, fechaEntrega])
  @@index([fechaEntrega])
  @@index([rutaId])
}

model DetallePedido {
  id                Int  @id @default(autoincrement())
  pedidoId          Int
  productoId        Int
  cantidad          Int // cubetas o gallinas
  precioUnitario    Int // precio congelado al crear el pedido
  // Lo que realmente se entregó; null mientras no se entrega. Menos que cantidad = entrega parcial.
  cantidadEntregada Int?

  pedido   Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoId], references: [id])
}

enum TipoVenta {
  VENTA
  SALDO_INICIAL // deuda que el cliente traía antes de usar la app
}

model Venta {
  id          Int       @id @default(autoincrement())
  consecutivo Int       @unique
  tipo        TipoVenta @default(VENTA)
  pedidoId    Int?      @unique
  clienteId   Int
  fecha       DateTime  @default(now())
  total       Int
  saldo       Int // lo que falta por pagar
  vence       DateTime  @db.Date
  usuarioId   Int
  anulada     Boolean   @default(false)
  nota        String?

  pedido       Pedido?                @relation(fields: [pedidoId], references: [id])
  cliente      Cliente                @relation(fields: [clienteId], references: [id])
  usuario      Usuario                @relation(fields: [usuarioId], references: [id])
  aplicaciones AplicacionPago[]
  movimientos  MovimientoInventario[]

  @@index([clienteId, saldo])
  @@index([clienteId, fecha])
}

enum MedioPago {
  EFECTIVO
  TRANSFERENCIA
}

model Pago {
  id           Int       @id @default(autoincrement())
  consecutivo  Int       @unique
  clienteId    Int
  fecha        DateTime  @default(now())
  dia          DateTime  @db.Date // día de caja (hora de Bogotá) en que entró el dinero
  valor        Int
  medio        MedioPago
  referencia   String?
  usuarioId    Int
  anulado      Boolean   @default(false)
  nota         String?
  // Solo transferencias: cuándo se confirmó en el banco que el dinero llegó.
  verificadoEn DateTime?
  // Cobrado por el repartidor en esa ruta; entra en su liquidación.
  rutaId       Int?

  cliente      Cliente          @relation(fields: [clienteId], references: [id])
  usuario      Usuario          @relation(fields: [usuarioId], references: [id])
  ruta         Ruta?            @relation(fields: [rutaId], references: [id])
  aplicaciones AplicacionPago[]

  @@index([clienteId, fecha])
  @@index([dia])
  @@index([rutaId])
}

// ---------- Rutas de entrega ----------

enum EstadoRuta {
  ABIERTA
  // El repartidor terminó y declaró el efectivo que entrega; falta la aprobación del administrador.
  PRECERRADA
  LIQUIDADA
}

model Ruta {
  id                Int        @id @default(autoincrement())
  fecha             DateTime   @db.Date
  repartidorId      Int
  estado            EstadoRuta @default(ABIERTA)
  creadaEn          DateTime   @default(now())
  // Se llenan en el precierre del repartidor y se confirman al liquidar: efectivo cobrado
  // según el sistema y el que el repartidor entregó.
  efectivoEsperado  Int?
  efectivoEntregado Int?
  diferencia        Int?
  observacion       String?
  precerradaEn      DateTime?
  liquidadaEn       DateTime?
  liquidadaPorId    Int?

  repartidor      Usuario          @relation("RepartidorRuta", fields: [repartidorId], references: [id])
  liquidadaPor    Usuario?         @relation("LiquidadorRuta", fields: [liquidadaPorId], references: [id])
  pedidos         Pedido[]
  pagos           Pago[]
  movimientosCaja MovimientoCaja[]

  @@unique([fecha, repartidorId])
}

model AplicacionPago {
  pagoId  Int
  ventaId Int
  valor   Int

  pago  Pago  @relation(fields: [pagoId], references: [id])
  venta Venta @relation(fields: [ventaId], references: [id])

  @@id([pagoId, ventaId])
}

// Contadores de consecutivos para recibos (VENTA, PAGO)
model Consecutivo {
  nombre String @id
  valor  Int    @default(0)
}

// ---------- Caja diaria ----------

enum EstadoCaja {
  ABIERTA
  CERRADA
}

model Caja {
  dia          DateTime   @id @db.Date
  estado       EstadoCaja @default(ABIERTA)
  base         Int        @default(0) // efectivo con el que empieza el día
  // Se llenan al cerrar
  esperado     Int?
  contado      Int?
  diferencia   Int?
  observacion  String?
  cerradaEn    DateTime?
  cerradaPorId Int?

  cerradaPor  Usuario?         @relation(fields: [cerradaPorId], references: [id])
  movimientos MovimientoCaja[]
}

enum TipoMovimientoCaja {
  INGRESO
  EGRESO
}

model MovimientoCaja {
  id              Int                @id @default(autoincrement())
  dia             DateTime           @db.Date
  fecha           DateTime           @default(now())
  tipo            TipoMovimientoCaja
  concepto        String
  valor           Int
  medio           MedioPago
  usuarioId       Int
  anulado         Boolean            @default(false)
  // Solo transferencias: cuándo se confirmó en el banco.
  verificadoEn    DateTime?
  // Diferencia de la liquidación de una ruta (faltante o sobrante del repartidor).
  rutaId          Int?
  // Pago a un proveedor (compra de contado o abono a una compra a crédito).
  compraId        Int?
  pagoProveedorId Int?

  caja          Caja           @relation(fields: [dia], references: [dia])
  usuario       Usuario        @relation(fields: [usuarioId], references: [id])
  ruta          Ruta?          @relation(fields: [rutaId], references: [id])
  compra        Compra?        @relation(fields: [compraId], references: [id])
  pagoProveedor PagoProveedor? @relation(fields: [pagoProveedorId], references: [id])

  @@index([dia])
}

// ---------- Proveedores y compras de huevo a terceros ----------

model Proveedor {
  id          Int      @id @default(autoincrement())
  nombre      String
  telefono    String?
  notas       String?
  diasCredito Int      @default(15)
  activo      Boolean  @default(true)
  creadoEn    DateTime @default(now())

  compras Compra[]
  pagos   PagoProveedor[]
}

enum FormaPagoCompra {
  CONTADO // sale de la caja del día
  CREDITO // queda como cuenta por pagar
}

model Compra {
  id            Int             @id @default(autoincrement())
  proveedorId   Int
  fecha         DateTime        @default(now())
  dia           DateTime        @db.Date
  usuarioId     Int
  // true = llegó clasificada por tipo y entró directo al inventario.
  clasificada   Boolean
  huevos        Int // total de huevos recibidos
  // Huevos que faltan por clasificar (solo compras sin clasificar).
  porClasificar Int             @default(0)
  total         Int // costo de la compra
  saldo         Int // lo que falta pagarle al proveedor
  formaPago     FormaPagoCompra
  vence         DateTime?       @db.Date
  anulada       Boolean         @default(false)
  nota          String?

  proveedor       Proveedor                 @relation(fields: [proveedorId], references: [id])
  usuario         Usuario                   @relation(fields: [usuarioId], references: [id])
  detalles        DetalleCompra[]
  movimientos     MovimientoInventario[]
  clasificaciones RegistroClasificacion[]
  aplicaciones    AplicacionPagoProveedor[]
  movimientosCaja MovimientoCaja[]

  @@index([proveedorId, saldo])
  @@index([proveedorId, fecha])
}

model DetalleCompra {
  compraId   Int
  productoId Int
  cantidad   Int // huevos

  compra   Compra   @relation(fields: [compraId], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoId], references: [id])

  @@id([compraId, productoId])
}

model PagoProveedor {
  id          Int       @id @default(autoincrement())
  proveedorId Int
  fecha       DateTime  @default(now())
  dia         DateTime  @db.Date
  valor       Int
  medio       MedioPago
  referencia  String?
  usuarioId   Int
  anulado     Boolean   @default(false)

  proveedor       Proveedor                 @relation(fields: [proveedorId], references: [id])
  usuario         Usuario                   @relation(fields: [usuarioId], references: [id])
  aplicaciones    AplicacionPagoProveedor[]
  movimientosCaja MovimientoCaja[]

  @@index([proveedorId, fecha])
}

model AplicacionPagoProveedor {
  pagoId   Int
  compraId Int
  valor    Int

  pago   PagoProveedor @relation(fields: [pagoId], references: [id])
  compra Compra        @relation(fields: [compraId], references: [id])

  @@id([pagoId, compraId])
}

// ---------- Galpones y aves ----------
// En pantalla solo hay galpones. Cada vez que entran aves a un galpón se crea un grupo de aves (a lo sumo uno
// activo por galpón); cuando salen todas, el grupo se cierra y queda como historial del galpón.

model Galpon {
  id        Int      @id @default(autoincrement())
  nombre    String   @unique
  capacidad Int?
  activo    Boolean  @default(true)
  creadoEn  DateTime @default(now())

  grupos GrupoAves[]
}

enum EtapaAves {
  CRIA
  LEVANTE
  POSTURA
  DESCARTE
}

model GrupoAves {
  id                 Int       @id @default(autoincrement())
  galponId           Int
  raza               String?
  fechaIngreso       DateTime  @db.Date
  edadIngresoSemanas Int       @default(0)
  cantidadInicial    Int
  etapa              EtapaAves @default(POSTURA)
  // false = ya salieron todas las aves del galpón
  activo             Boolean   @default(true)
  nota               String?
  creadoEn           DateTime  @default(now())

  galpon           Galpon                  @relation(fields: [galponId], references: [id])
  novedades        NovedadAves[]           @relation("NovedadOrigen")
  trasladosEntrada NovedadAves[]           @relation("NovedadDestino")
  clasificaciones  RegistroClasificacion[]
}

enum TipoNovedad {
  MUERTE
  DESCARTE
  VENTA // pasan al inventario de gallinas para vender
  TRASLADO // pasan a otro galpón
}

model NovedadAves {
  id             Int         @id @default(autoincrement())
  grupoId        Int
  fecha          DateTime    @db.Date
  tipo           TipoNovedad
  cantidad       Int
  grupoDestinoId Int?
  nota           String?
  usuarioId      Int
  creadoEn       DateTime    @default(now())
  anulada        Boolean     @default(false)

  grupo        GrupoAves              @relation("NovedadOrigen", fields: [grupoId], references: [id])
  grupoDestino GrupoAves?             @relation("NovedadDestino", fields: [grupoDestinoId], references: [id])
  usuario      Usuario                @relation(fields: [usuarioId], references: [id])
  movimientos  MovimientoInventario[]

  @@index([grupoId])
  @@index([grupoDestinoId])
}
